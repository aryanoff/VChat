# ==============================================================
# VChat Environment Configuration (.env.example)
# ==============================================================
# For local development: Copy this file to `.env` or `.env.local`.
# For Cloudflare Pages: Set these variables in Cloudflare Dashboard:
#   Pages Project -> Settings -> Environment variables
# ==============================================================

# --------------------------------------------------------------
# 1. SUPABASE BROWSER CREDENTIALS (SAFE FOR CLIENT)
# --------------------------------------------------------------
# Retrieve from Supabase Dashboard -> Project Settings -> API
# Use your Publishable Key (or legacy anon key). RLS is the security boundary.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Vite-style aliases (Both naming conventions are fully supported):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# --------------------------------------------------------------
# 2. APPLICATION URLS
# --------------------------------------------------------------
# Local development URL
VITE_APP_URL=http://localhost:3000
# Production Cloudflare Pages URL
VITE_PRODUCTION_URL=https://vchat-ckw.pages.dev

# Fallback alias for local redirects
VCHAT_PUBLIC_URL=http://localhost:3000

# --------------------------------------------------------------
# 3. VERIFICATION & RUNTIME CONFIG
# --------------------------------------------------------------
# In development, set to true to display the mock SMS OTP code in a UI toast.
# In production, set to false (real SMS requires a connected provider via Edge Function).
VCHAT_DEV_MOBILE_OTP=true

# --------------------------------------------------------------
# 4. SECURITY NOTICE — NEVER COMMIT OR EXPOSE PRIVATE SECRETS
# --------------------------------------------------------------
# DO NOT place SUPABASE_SERVICE_ROLE_KEY, database passwords,
# Google OAuth Client Secrets, or SMS/email provider tokens in this file
# or in any client-side JavaScript.
