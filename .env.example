# Copy this file to `.env` for the local Node static server.
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend JavaScript.

# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key — safe for the browser when RLS is enabled
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Optional aliases (Cloudflare Pages / Vite-style)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Public site origin used for Auth redirects (local or production)
VCHAT_PUBLIC_URL=http://localhost:3000

# Development-only: allow the SQL RPC to return a mock mobile OTP.
# Set to false in production. This is NOT real SMS.
VCHAT_DEV_MOBILE_OTP=true

# NEVER expose this to the browser. Used only in the Supabase dashboard / Edge Functions.
# SUPABASE_SERVICE_ROLE_KEY=
